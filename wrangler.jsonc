{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "native-ai",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./docs",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "PUBLIC_AI_ENABLED": "true",
  "AI_PROVIDER": "groq",
  "AI_MODEL": "openai/gpt-oss-120b",
  "TURNSTILE_SITE_KEY": "0x4AAAAAAFYo6LZ0AYNBMzTp"
  },
  "ratelimits": [
    {
      "name": "GENERATION_LIMITER",
      "namespace_id": "10701",
      "simple": {
        "limit": 1,
        "period": 60
      }
    },
    {
      "name": "GLOBAL_LIMITER",
      "namespace_id": "10702",
      "simple": {
        "limit": 2,
        "period": 60
      }
    }
  ]
}
